{
  "name": "mydevnotes",
  "displayName": "My Dev Notes",
  "description": "Workspace-scoped TODO list and scratch pad with groups, archive, markdown notes, and MCP server",
  "version": "0.9.5",
  "publisher": "tristancartledge",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/reefbarman/mydevnotes"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "todo",
    "task",
    "notes",
    "scratch pad",
    "markdown",
    "productivity",
    "mcp",
    "claude"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mydevnotes-sidebar",
          "title": "My Dev Notes",
          "icon": "$(notebook)"
        }
      ]
    },
    "views": {
      "mydevnotes-sidebar": [
        {
          "type": "webview",
          "id": "mydevnotes.mainView",
          "name": "My Dev Notes"
        }
      ]
    },
    "commands": [
      {
        "command": "mydevnotes.addTodo",
        "title": "Add TODO",
        "category": "My Dev Notes",
        "icon": "$(add)"
      }
    ],
    "configuration": {
      "title": "My Dev Notes",
      "properties": {
        "mydevnotes.mcpAutoRegister": {
          "type": "string",
          "enum": [
            "enabled",
            "disabled",
            "ask"
          ],
          "default": "ask",
          "description": "Automatically register the MCP server for AI agents (e.g. Claude Code) in each workspace."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "mydevnotes.addTodo",
          "when": "view == mydevnotes.mainView",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run bundle:mcp && npm run bundle:webview",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "bundle:mcp": "esbuild mcp-server.js --bundle --platform=node --target=node18 --outfile=out/mcp-server.js --format=cjs",
    "bundle:webview": "esbuild webview/App.tsx --bundle --outfile=out/webview.js --format=iife --target=es2020 --jsx=automatic --jsx-import-source=preact --external:vscode",
    "package": "vsce package --no-dependencies",
    "reinstall": "npm version patch --no-git-tag-version && npm run package && code --install-extension mydevnotes-$(node -p \"require('./package.json').version\").vsix --force",
    "release": "bash scripts/release.sh",
    "release:install": "bash scripts/release.sh --install"
  },
  "dependencies": {
    "marked": "^15.0.0",
    "preact": "^10.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "esbuild": "^0.27.3",
    "typescript": "^5.3.0"
  }
}
