{
  "name": "mytodos",
  "displayName": "My TODOs",
  "description": "Workspace-scoped TODO list with groups and archive",
  "version": "0.8.1",
  "publisher": "tristancartledge",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/reefbarman/mytodos"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "todo",
    "task",
    "productivity",
    "mcp",
    "claude"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mytodos-sidebar",
          "title": "My TODOs",
          "icon": "media/todo-icon.svg"
        }
      ]
    },
    "views": {
      "mytodos-sidebar": [
        {
          "type": "webview",
          "id": "mytodos.todoView",
          "name": "My TODOs"
        }
      ]
    },
    "commands": [
      {
        "command": "mytodos.addTodo",
        "title": "Add TODO",
        "category": "My TODOs",
        "icon": "$(add)"
      }
    ],
    "configuration": {
      "title": "My TODOs",
      "properties": {
        "mytodos.mcpAutoRegister": {
          "type": "string",
          "enum": [
            "enabled",
            "disabled",
            "ask"
          ],
          "default": "ask",
          "description": "Automatically register the MCP server for AI agents (e.g. Claude Code) in each workspace."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "mytodos.addTodo",
          "when": "view == mytodos.todoView",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run bundle:mcp",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "bundle:mcp": "esbuild mcp-server.js --bundle --platform=node --target=node18 --outfile=out/mcp-server.js --format=cjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "esbuild": "^0.27.3",
    "typescript": "^5.3.0"
  }
}
